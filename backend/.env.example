# ============================
# MecardStudio backend configuration
# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.
# ============================

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL database
DB_NAME=mecard_studio
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Choose one active provider: gemini, claude, openai, or codex.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=  # Claude (CLAUDE_API_KEY is also accepted)
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=     # OpenAI API (CODEX_API_KEY is also accepted)
OPENAI_MODEL=gpt-5.1
CODEX_MODEL=gpt-5.1-codex
AI_MAX_TOKENS=8192
